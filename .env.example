# ==============================================================================
# Nexa Chat — Environment Configuration Template
# Copy this file to .env (and/or apps/api/.env, apps/web/.env.local)
# NEVER commit real API keys, JWT secrets, or database passwords.
# ==============================================================================

# --- PostgreSQL 17 (Docker Compose) ---
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=nexa_chat
POSTGRES_PORT=5432

# --- Backend API (NestJS) ---
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Prisma connection strings
DATABASE_URL="postgresql://nexa_user:change_me_local_dev_only@127.0.0.1:5432/nexa_chat?schema=public"
TEST_DATABASE_URL="postgresql://nexa_user:change_me_local_dev_only@127.0.0.1:5432/nexa_chat_test?schema=public"

# Authentication (use at least 32 random characters in real local .env)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=nexa_session

# --- Gemini API (Free Tier ONLY) ---
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_DISPLAY_NAME="Gemini 3.5 Flash-Lite — Free Tier"

# --- Chat & Context Limits ---
MAX_HISTORY_MESSAGES=20
MAX_INPUT_CHARS=8000
MAX_CONTEXT_CHARS=32000

# --- Per-User Rate Limiting (in-memory) ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# --- Frontend Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_MODEL_DISPLAY_NAME="Gemini 3.5 Flash-Lite — Free Tier"
